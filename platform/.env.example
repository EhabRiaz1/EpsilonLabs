# Publishable values only in NEXT_PUBLIC_* (F11). Copy to .env.local for local dev.
NEXT_PUBLIC_SUPABASE_URL=https://lueawvqogdodtjsfqdeh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_wBlISifBoKak7vc97CgnTg_TKjux1aJ

# ---- Server-only. Set in Vercel (Production + Preview); never prefix with NEXT_PUBLIC_. Leave empty here. ----
# Service role: used ONLY by the public deal room (app/client/p) and the invoice PDF code (lib/invoice-pdf.ts).
# A documented narrowing of F11; admin pages still act as the signed-in user. eslint enforces where it is imported.
SUPABASE_SERVICE_ROLE_KEY=
# HMAC key for proposal links (>= 32 random chars, e.g. `openssl rand -base64 48`). Only sha256(link token) is stored.
# Rotating it keeps every emailed link working but stops "Copy link" for proposals sent before the rotation.
PROPOSAL_LINK_SECRET=
# Zoho SMTP for notifications@epsilon-labs.co (F9).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Issuer address and payment details printed on invoices (JSON). Without it, invoice PDFs stay "pending".
# {"address":"…\n…","email":"er@epsilon-labs.co","regLine":"CUIN 0290150","payHint":"…",
#  "payRows":[{"label":"Account holder","value":"…"},{"label":"IBAN","value":"…"},{"label":"SWIFT / BIC","value":"…"}],
#  "bankName":"…","bankAddress":"…\n…","footerText":"Epsilon Labs AI Solutions (SMC-Private) Limited · NTN …"}
INVOICE_DETAILS_JSON=
# Local dev only: Chrome for PDF rendering (defaults to /Applications/Google Chrome.app).
CHROME_PATH=
