{
  "$comment": "Delivery report content (skills/delivery-report/SKILL.md). The worker's tool-less model call fills it (plus a top-level 'notes' for the founder, which is stripped before saving); platform/lib/report-schema.json is a byte-identical copy that the hosted renderer and editor validate against. Change both together (tests/test_platform_jobs.py checks they match).",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "subtitle", "summary", "kpis", "measures", "sections", "verification", "outstanding"],
  "properties": {
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "subtitle": {"type": "string", "maxLength": 160},
    "prepared_for": {"type": "string", "maxLength": 160},
    "summary": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "string", "minLength": 1, "maxLength": 1500}},
    "kpis": {
      "type": "array", "maxItems": 6,
      "items": {"type": "object", "additionalProperties": false, "required": ["value", "label"],
                "properties": {"value": {"type": "string", "minLength": 1, "maxLength": 16},
                               "label": {"type": "string", "minLength": 1, "maxLength": 40}}}
    },
    "measures": {
      "type": "array", "maxItems": 14,
      "items": {"type": "object", "additionalProperties": false, "required": ["measure", "before", "after"],
                "properties": {"measure": {"type": "string", "minLength": 1, "maxLength": 160},
                               "before": {"type": "string", "maxLength": 40},
                               "after": {"type": "string", "maxLength": 40}}}
    },
    "sections": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["title", "intro", "callout", "rows"],
        "properties": {
          "title": {"type": "string", "minLength": 1, "maxLength": 80},
          "intro": {"type": "string", "maxLength": 1500},
          "callout": {"anyOf": [
            {"type": "null"},
            {"type": "object", "additionalProperties": false, "required": ["label", "text"],
             "properties": {"label": {"type": "string", "minLength": 1, "maxLength": 40},
                            "text": {"type": "string", "minLength": 1, "maxLength": 1500}}}]},
          "rows": {
            "type": "array", "maxItems": 24,
            "items": {"type": "object", "additionalProperties": false, "required": ["item", "outcome", "new"],
                      "properties": {"item": {"type": "string", "minLength": 1, "maxLength": 160},
                                     "outcome": {"type": "string", "maxLength": 800},
                                     "new": {"type": "boolean"}}}
          }
        }
      }
    },
    "verification": {
      "type": "array", "maxItems": 14,
      "items": {"type": "object", "additionalProperties": false, "required": ["claim", "proof"],
                "properties": {"claim": {"type": "string", "minLength": 1, "maxLength": 160},
                               "proof": {"type": "string", "minLength": 1, "maxLength": 800}}}
    },
    "outstanding": {
      "type": "array", "maxItems": 14,
      "items": {"type": "object", "additionalProperties": false, "required": ["item", "action"],
                "properties": {"item": {"type": "string", "minLength": 1, "maxLength": 160},
                               "action": {"type": "string", "minLength": 1, "maxLength": 800}}}
    },
    "notes": {"type": "string", "maxLength": 600}
  }
}
