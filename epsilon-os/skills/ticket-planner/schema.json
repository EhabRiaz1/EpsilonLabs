{
  "$comment": "Structured output of the read-only plan agent (agents/project_agent.py, --json-schema). Admin renders it on the ticket page.",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "files", "steps", "risks", "tests_to_add", "estimate_hours", "questions_for_client", "notes"],
  "properties": {
    "summary": {"type": "string", "minLength": 1, "maxLength": 1200},
    "files": {"type": "array", "maxItems": 30, "items": {
      "type": "object", "additionalProperties": false, "required": ["path", "change"],
      "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 300},
                     "change": {"type": "string", "minLength": 1, "maxLength": 300}}}},
    "steps": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 400}},
    "risks": {"type": "array", "maxItems": 10, "items": {"type": "string", "minLength": 1, "maxLength": 400}},
    "tests_to_add": {"type": "array", "maxItems": 15, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
    "estimate_hours": {"type": "object", "additionalProperties": false, "required": ["low", "high"],
                       "properties": {"low": {"type": "number", "minimum": 0, "maximum": 400},
                                      "high": {"type": "number", "minimum": 0, "maximum": 400}}},
    "questions_for_client": {"type": "array", "maxItems": 5, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
    "notes": {"type": "string", "maxLength": 600}
  }
}
